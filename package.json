{
  "name": "strapla",
  "version": "0.5.0",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "copy:guard": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/copy-guard.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "opening:template": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/opening-import.ts template",
    "opening:validate": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/opening-import.ts validate",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.mjs",
    "e2e": "playwright test"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "exceljs": "^4.4.0",
    "next": "^16.4.6",
    "postgres": "^4.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "postcss": "^8.5.33",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "vitest": "^5.1.1"
  },
  "packageManager": "pnpm@11.28.8"
}
